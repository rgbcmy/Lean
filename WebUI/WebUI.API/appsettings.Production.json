{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error",
      "WebUI": "Information"
    }
  },
  "AllowedHosts": "*",
  "WebUI": {
    "DatabaseProvider": "${WEBUI_DB_PROVIDER:PostgreSQL}",
    "JwtSecret": "${JWT_SECRET}",
    "JwtIssuer": "LeanWebUI",
    "JwtAudience": "LeanWebUIClient",
    "JwtExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 30,
    "EnableAuditLogging": true,
    "EnableRateLimiting": true,
    "RateLimitRequests": 60,
    "RateLimitPeriodMinutes": 1,
    "ServeStaticFiles": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "${WEBUI_CONNECTION_STRING:Host=localhost;Port=5432;Database=leanwebui;Username=leanuser;Password=}",
    "SQLiteConnection": "${WEBUI_SQLITE_PATH:Data Source=/var/lib/leanwebui/webui.db}"
  },
  "IBKR": {
    "TWSHost": "${IBKR_TWS_HOST:127.0.0.1}",
    "TWSPort": "${IBKR_TWS_PORT:7496}",
    "ClientId": "${IBKR_CLIENT_ID:1}",
    "ConnectionTimeout": 30,
    "ReconnectInterval": 10,
    "EnableAutoReconnect": true,
    "EnableHeartbeat": true,
    "HeartbeatIntervalSeconds": 10
  },
  "CORS": {
    "AllowedOrigins": [
      "${WEBUI_FRONTEND_URL:https://localhost:5001}"
    ],
    "AllowCredentials": true
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:5001",
        "Certificate": {
          "Path": "${CERT_PATH:/etc/ssl/certs/leanwebui.pfx}",
          "Password": "${CERT_PASSWORD}"
        }
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "Security": {
    "EnableHSTS": true,
    "HSTSMaxAge": 31536000,
    "EnableHTTPSRedirect": true,
    "RequireHTTPS": true,
    "EnableCSP": true,
    "CSPPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss:",
    "EnableXContentTypeOptions": true,
    "EnableXFrameOptions": true,
    "XFrameOptionsValue": "DENY",
    "EnableXXSSProtection": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "${LOG_PATH:/var/log/leanwebui/webui-.log}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "${SEQ_URL:http://localhost:5341}",
          "apiKey": "${SEQ_API_KEY}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "HealthChecks": {
    "EnableDetailedErrors": false,
    "Timeout": 30
  },
  "Monitoring": {
    "EnablePrometheus": true,
    "PrometheusPath": "/metrics",
    "EnableApplicationInsights": false,
    "ApplicationInsightsConnectionString": "${APPINSIGHTS_CONNECTION_STRING}"
  },
  "Backup": {
    "EnableAutomaticBackup": true,
    "BackupSchedule": "0 2 * * *",
    "BackupPath": "${BACKUP_PATH:/var/backups/leanwebui}",
    "RetentionDays": 30,
    "EnableCompression": true
  },
  "Performance": {
    "EnableResponseCompression": true,
    "EnableOutputCaching": true,
    "CacheDurationSeconds": 60,
    "EnableConnectionPooling": true,
    "MaxPoolSize": 100,
    "MinPoolSize": 10
  }
}
