# Production Environment Variables Template
# Copy this file to .env.production and fill in the actual values
# NEVER commit .env.production to version control

# Database Configuration
WEBUI_DB_PROVIDER=PostgreSQL
WEBUI_CONNECTION_STRING=Host=localhost;Port=5432;Database=leanwebui;Username=leanuser;Password=CHANGE_ME
# Or for SQLite:
# WEBUI_DB_PROVIDER=SQLite
# WEBUI_SQLITE_PATH=/var/lib/leanwebui/webui.db

# JWT Authentication
JWT_SECRET=GENERATE_A_STRONG_SECRET_KEY_HERE_AT_LEAST_256_BITS
# You can generate a secure key with: openssl rand -base64 64

# HTTPS Certificate
CERT_PATH=/etc/ssl/certs/leanwebui.pfx
CERT_PASSWORD=CHANGE_ME

# IBKR Configuration
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=7496
IBKR_CLIENT_ID=1

# Frontend URL
WEBUI_FRONTEND_URL=https://yourdomain.com

# Logging
LOG_PATH=/var/log/leanwebui/webui-.log

# Seq Logging (optional)
SEQ_URL=http://localhost:5341
SEQ_API_KEY=

# Application Insights (optional)
APPINSIGHTS_CONNECTION_STRING=

# Backup Configuration
BACKUP_PATH=/var/backups/leanwebui
